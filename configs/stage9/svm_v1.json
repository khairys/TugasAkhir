{
  "experiment_name": "linear_svm_baseline_v1",
  "stage": "stage9",
  "seed": 42,
  "data": {
    "train_path": "data/splits/v1/train_v1.csv",
    "validation_path": "data/splits/v1/validation_v1.csv",
    "text_column": "text_raw",
