  },
  "candidate_grid": [
    {
      "config_id": "cfg_1_ngram11_c01",
      "ngram_range": [1, 1],
      "C": 0.1
    },
    {
      "config_id": "cfg_2_ngram11_c10",
      "ngram_range": [1, 1],
      "C": 1.0
    },
    {
      "config_id": "cfg_3_ngram11_c100",
      "ngram_range": [1, 1],
      "C": 10.0
    },
    {
      "config_id": "cfg_4_ngram12_c01",
      "ngram_range": [1, 2],
      "C": 0.1
    },
    {
      "config_id": "cfg_5_ngram12_c10",
      "ngram_range": [1, 2],
      "C": 1.0
    },
    {
      "config_id": "cfg_6_ngram12_c100",
      "ngram_range": [1, 2],
      "C": 10.0
    }
  ],
  "selection_criteria": {
    "primary_metric": "f1_promotion",
    "tie_breaker_order": [
